          "lectures": [
            {
              "id": "lec_7_1_1",
              "title": "Docker 이미지 최적화 빌드",
              "duration": "40:00",
              "type": "video",
              "note": "<h3>효율적인 Dockerfile 팁</h3><p>멀티 스테이지 빌드 패턴을 통해 런타임 이미지의 용량을 극적으로 줄일 수 있습니다.</p><pre><code># Build stage\nFROM node:18 AS builder\nWORKDIR /app\nCOPY . .\nRUN npm ci && npm run build\n\n# Production stage\nFROM nginx:alpine\nCOPY --from=builder /app/dist /usr/share/nginx/html\nEXPOSE 80\nCMD [\"nginx\", \"-g\", \"daemon off;\"]</code></pre>"
            },
            {
              "id": "lec_7_1_2",
